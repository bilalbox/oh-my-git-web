{
  "name": "oh-my-git-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web port of Oh My Git!. Levels and artwork stay in a sibling checkout of the original game.",
  "scripts": {
    "check": "node check-intro.mjs && node check-levels.mjs && node check-chapter.mjs",
    "check:browser": "node check-browser.mjs",
    "dev": "vite",
    "build": "vite build && node assemble.mjs",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@wasmer/sdk": "0.19.1"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "playwright": "^1.64.1",
    "vite": "^8.3.6",
    "wrangler": "^4.161.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
